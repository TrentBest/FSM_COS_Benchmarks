<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>FSM_COS.Benchmarks</AssemblyName>
    <RootNamespace>FSM_COS_Benchmarks</RootNamespace>
    <FsmCosSourceProject Condition="'$(FsmCosSourceProject)' == '' and Exists('source/src/FSM_COS/FSM_COS.csproj')">source/src/FSM_COS/FSM_COS.csproj</FsmCosSourceProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The FSM_COS checkout lives beneath this project for CI, but must compile
         only through ProjectReference, never through this project's default globs. -->
    <Compile Remove="source/**/*.cs" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(FsmCosSourceProject)' != ''">
    <ProjectReference Include="$(FsmCosSourceProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FsmCosSourceProject)' == ''">
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.6" />
  </ItemGroup>
</Project>
